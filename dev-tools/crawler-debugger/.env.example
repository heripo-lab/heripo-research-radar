# Local environment for the crawler debugger and the parser health-check.
#
# Copy this file to `.env` in the same directory and fill in what you need.
# `.env` is gitignored; `npm run dev:crawler`, `npm run health-check` and
# `npm run health-check:proxy` load it automatically when it exists, so both
# tools work unchanged without it.

# data.go.kr service key for the three open-API targets: 나라일터 and 알리오
# under Employment, and 나라장터 under Business. One key serves all of them —
# subscribe to each service on the portal under the same account.
# Use the encoded key exactly as the portal shows it, including the %2B and %3D
# escapes. Without it those targets return an empty list and the health-check
# skips them instead of reporting a failure.
PUBLIC_DATA_API_KEY=

# No LLM key belongs here. Neither `npm run dev:crawler` nor
# `npm run health-check` calls a model: both build the 나라장터 adapter without
# its `triage` option, so the deterministic filter in
# `src/crawling/heritage-job-filter.ts` decides and nothing is sent to OpenAI.
# The health-check answers whether a source still fetches and parses, and adding
# a model to it would put an API bill and a second failure mode behind that
# question. Only `generateNewsletter()` supplies triage.

# Outbound proxy for crawling. Only `npm run dev:crawler:proxy` and
# `npm run health-check:proxy` use it; the non-proxy scripts ignore it.
PROXY_URL=
