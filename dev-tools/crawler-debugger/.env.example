# Local environment for the crawler debugger and the parser health-check.
#
# Copy this file to `.env` in the same directory and fill in what you need.
# `.env` is gitignored; `npm run dev:crawler`, `npm run health-check` and
# `npm run health-check:proxy` load it automatically when it exists, so both
# tools work unchanged without it.

# data.go.kr service key for the 나라일터 and 알리오 job boards.
# Use the encoded key exactly as the portal shows it, including the %2B and %3D
# escapes. Without it those two targets return an empty list and the
# health-check skips them instead of reporting a failure.
PUBLIC_DATA_API_KEY=

# Outbound proxy for crawling. Only `npm run dev:crawler:proxy` and
# `npm run health-check:proxy` use it; the non-proxy scripts ignore it.
PROXY_URL=
