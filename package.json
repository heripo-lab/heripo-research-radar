{
  "name": "@heripo/research-radar",
  "private": false,
  "type": "module",
  "version": "6.4.2",
  "description": "AI-driven intelligence for Korean cultural heritage. This package serves as both a ready-to-use newsletter service and a practical implementation example for the LLM-Newsletter-Kit.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run typecheck && tsdown",
    "prepublishOnly": "npm run build",
    "release": "node scripts/release.mjs none",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "lint:ci": "eslint --quiet ./src",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --import @oxc-node/core/register --test test/*.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\"",
    "dev:crawler": "node --import @oxc-node/core/register --watch --env-file-if-exists=dev-tools/crawler-debugger/.env dev-tools/crawler-debugger/server.ts",
    "dev:crawler:proxy": "node --import @oxc-node/core/register --watch --env-file=dev-tools/crawler-debugger/.env dev-tools/crawler-debugger/server.ts",
    "dev:newsletter-preview": "node --import @oxc-node/core/register --watch dev-tools/newsletter-preview/server.ts",
    "dev:welcome-preview": "node --import @oxc-node/core/register --watch dev-tools/welcome-preview/server.ts",
    "health-check": "node --import @oxc-node/core/register --env-file-if-exists=dev-tools/crawler-debugger/.env dev-tools/health-check/index.ts",
    "health-check:proxy": "node --import @oxc-node/core/register --env-file-if-exists=dev-tools/crawler-debugger/.env dev-tools/health-check/index.ts --proxy",
    "dev:link-core": "npm --prefix ../llm-newsletter-kit-core run build && npm link ../llm-newsletter-kit-core",
    "dev:unlink-core": "npm unlink --no-save @llm-newsletter-kit/core && npm install"
  },
  "author": "kimhongyeon",
  "license": "Apache-2.0",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/google": "^4.0.124",
    "@ai-sdk/openai": "^4.0.122",
    "ai": "^7.0.179",
    "cheerio": "^1.2.0",
    "dompurify": "^3.4.18",
    "jsdom": "^31.0.1",
    "juice": "^12.2.6",
    "safe-markdown2html": "^1.0.20",
    "turndown": "^7.2.5"
  },
  "peerDependencies": {
    "@llm-newsletter-kit/core": "~3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@llm-newsletter-kit/core": "^3.2.1",
    "@oxc-node/core": "^1.0.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.15.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "express": "^5.3.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "tsdown": "~0.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heripo-lab/heripo-research-radar"
  },
  "bugs": {
    "url": "https://github.com/heripo-lab/heripo-research-radar/issues"
  },
  "homepage": "https://heripo.app",
  "keywords": [
    "cultural-heritage",
    "archaeology",
    "art-history",
    "korean-heritage",
    "museum",
    "heripo",
    "research-radar",
    "llm-newsletter-kit",
    "newsletter",
    "ai-newsletter",
    "research-automation",
    "intelligence",
    "data-analysis",
    "excavation",
    "driver",
    "example"
  ],
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {},
  "overrides": {
    "body-parser": "^2.4.0",
    "postcss": "^8.5.23",
    "minimatch": "^11.0.3",
    "glob": "^14.0.3"
  }
}
